#!/usr/bin/env bash
# Loki Mode pre-push hook
#
# Runs before `git push` to catch the failure modes that have actually
# burned us in past releases:
#   1. A pre-existing test asserts on a contract you changed (v6.77.1 hot-fix)
#   2. A bash syntax error slips into autonomy/run.sh or autonomy/loki
#   3. The WRONG git identity (Disney murel002) leaking onto a github.com push
#      -- a real past incident: a commit landed as murel002 instead of asklokesh
#      because the repo-local .git/config was not set before committing.
#
# git passes the remote name + URL on argv: $1=<name> $2=<url>.
#
# Install:  ./scripts/install-hooks.sh
# Skip once: PRE_PUSH_SKIP=1 git push   (use sparingly; CI will catch you)

set -euo pipefail

if [[ "${PRE_PUSH_SKIP:-0}" == "1" ]]; then
    echo "[pre-push] PRE_PUSH_SKIP=1 set, skipping"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

failures=0

# --- Identity guard: never push to github.com under the Disney identity -------
# The global gitconfig defaults to murel002 (github.disney.com); a repo that
# forgot to set its local user.email would silently push commits authored as
# murel002 to github.com/asklokesh. Deterministic, no model, fires at the last
# gate before the identity reaches GitHub. Only enforces for github.com remotes
# (github.disney.com pushes legitimately use murel002 and are exempt).
remote_url="${2:-$(git remote get-url --push "${1:-origin}" 2>/dev/null || echo "")}"
if [[ "$remote_url" == *"github.com"* ]]; then
    id_email="$(git config user.email 2>/dev/null || echo "")"
    id_name="$(git config user.name 2>/dev/null || echo "")"
    if [[ "$id_email" != "lokeshmure@live.com" || "$id_name" != "asklokesh" ]]; then
        echo "[pre-push] FAIL: github.com push requires identity asklokesh <lokeshmure@live.com>" >&2
        echo "[pre-push]   current repo identity: ${id_name:-<unset>} <${id_email:-<unset>}>" >&2
        echo "[pre-push]   fix: git config user.name asklokesh && git config user.email lokeshmure@live.com" >&2
        failures=$((failures + 1))
    fi
fi

echo "[pre-push] bash -n autonomy/run.sh"
if ! bash -n autonomy/run.sh; then
    echo "[pre-push] FAIL: autonomy/run.sh has syntax errors" >&2
    failures=$((failures + 1))
fi

echo "[pre-push] bash -n autonomy/loki"
if ! bash -n autonomy/loki; then
    echo "[pre-push] FAIL: autonomy/loki has syntax errors" >&2
    failures=$((failures + 1))
fi

if command -v python3 >/dev/null 2>&1 && [[ -f pytest.ini ]]; then
    echo "[pre-push] python3 -m pytest -q"
    if ! python3 -m pytest -q 2>&1 | tail -25; then
        echo "[pre-push] FAIL: python tests failed (full output above)" >&2
        failures=$((failures + 1))
    fi
fi

# --- Red-main guard ----------------------------------------------------------
# THE FAILURE THIS EXISTS FOR, measured 2026-07-30: main sat RED for THREE
# consecutive releases (v8.0.3, v8.1.0, and the commit before them) because
# nothing ever forced anyone to look. The red was reporting a GENUINE bug the
# whole time -- providers/opencode.sh silently dropped every caller-supplied
# flag -- and three releases shipped straight over it.
#
# A warning, not a block. Whether the tip is red is a fact about the PREVIOUS
# push, and the most common reason to push onto a red main is to FIX it, which
# a hard block would prevent. But it must be impossible to do accidentally: you
# now have to read the words "main is currently RED" before your push proceeds.
#
# Requires gh; silently skipped without it (an offline or gh-less machine still
# pushes normally, and CI remains the backstop).
if command -v gh >/dev/null 2>&1 && [[ "${PRE_PUSH_NO_CI_CHECK:-0}" != "1" ]]; then
    _tip_state=$(gh run list --branch main --workflow=Tests --limit 1 \
                    --json conclusion --jq '.[0].conclusion' 2>/dev/null || echo "")
    if [[ "$_tip_state" == "failure" ]]; then
        echo "[pre-push] ---------------------------------------------------" >&2
        echo "[pre-push] WARNING: main is currently RED (last Tests run failed)." >&2
        echo "[pre-push] If this push is not the fix, you are stacking work on" >&2
        echo "[pre-push] a broken tip -- that is how v8.0.3 through v8.1.0 shipped" >&2
        echo "[pre-push] over a real arg-dropping bug in the opencode provider." >&2
        echo "[pre-push]   gh run list --branch main --workflow=Tests --limit 1" >&2
        echo "[pre-push] ---------------------------------------------------" >&2
    fi
fi

if [[ $failures -gt 0 ]]; then
    echo "[pre-push] $failures check(s) failed -- aborting push" >&2
    echo "[pre-push] Re-run after fixing, or skip with PRE_PUSH_SKIP=1 git push" >&2
    exit 1
fi

echo "[pre-push] all checks passed"
